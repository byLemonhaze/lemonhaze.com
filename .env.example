# Copy to .dev.vars for local testing; never put real keys in this example or chat.
# Local development refuses live Stripe keys. Production secrets belong in Cloudflare.
SHOP_MODE=test
SHOP_ORIGIN=http://127.0.0.1:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHOP_RATE_SECRET=
# JSON amount is USD cents; this is deliberately TEST ONLY, not a carrier quote.
SHOP_SHIPPING_JSON='{"countries":["CA","US"],"amount":0,"label":"Test shipping — not a real delivery quote","dispatch":"Test checkout only"}'
SHOP_TAX_MODE=none
SHOP_COLLECT_PHONE=false
# Production requires all these gates, a separate SHOP_DB binding, and HTTPS.
SHOP_LIVE_ENABLED=false
SHOP_POLICIES_CONFIRMED=false
SHOP_CONTACT_EMAIL=
SHOP_RETURNS_TEXT=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Separate sales permission: keep false for the first public deployment.
SHOP_STOREFRONT_OPEN=false
# Vite build variable: set in .env.local or the build environment, NOT .dev.vars.
# Only turn both switches on when the artist explicitly opens sales.
VITE_SHOP_STOREFRONT_OPEN=false
